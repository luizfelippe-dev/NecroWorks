extends "res://tools/preview_skeleton_motion.gd"

func _initialize() -> void:
	call_deferred("validate_lab")

func validate_lab() -> void:
	await build()
	assert(drivers.size() == 2)
	assert(drivers[0].frame_sequences.is_empty())
	assert(drivers[1].frame_sequences.move.size() == 8)
	activate("0.5x")
	assert(speed == 0.5)
	_process(0.1)
	assert(is_equal_approx(sample_positions[1].x, 4.5))
	activate("Pausa")
	var phase: float = drivers[1].gait_phase
	_process(1.0)
	assert(drivers[1].gait_phase == phase)
	activate("Pausa")
	activate("Andar / Parar")
	_process(1.0)
	assert(drivers[1].current_animation == "idle")
	activate("Atacar")
	assert(drivers[1].current_animation == "attack")
	activate("Movimento reduzido")
	assert(drivers[0].reduced_motion and drivers[1].reduced_motion)
	activate("2x")
	assert(speed == 2)
	_process(1.0)
	assert(drivers[1].current_animation == "idle")
	for family: String in FAMILIES:
		select_family(family)
		assert(drivers.size() == 2 and sample_hosts.size() == 2)
		assert(drivers[1].reduced_motion)
		assert(drivers[1].frame_sequences.is_empty() == (family not in ["skeleton", "zombie"]))
		activate("Atacar")
		activate("Receber dano")
		assert(drivers[1].current_animation == "attack")
		_process(0.5)
		assert(drivers[1].current_animation == "idle")
	select_family("zombie")
	activate("Ataque repetido")
	_process(0.01)
	assert(drivers[1].current_animation == "attack")
	activate("Pausa")
	var clock_before := attack_clock
	_process(1.0)
	assert(attack_clock == clock_before)
	activate("Pausa")
	activate("Ataque repetido")
	select_family("invalid")
	assert(visual_id == "zombie")
	print("ANIMATION LAB: PASS")
	quit()
